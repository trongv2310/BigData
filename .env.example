# Sao chép thành .env và điền. KHÔNG commit .env.
OWM_API_KEY=
HDFS_NAMENODE_HTTP=http://localhost:9870
DATANODE_HTTP_PORTS=9864,9874,9884,9894
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_TOPIC=hcmc_co_stream
SPARK_UI_PORTS=4040,4041,4042,4043
YARN_RM=http://localhost:8088
AIRFLOW_UI=http://localhost:8080
HDFS_STREAM_DIR=/stream_input
HDFS_RAW_PATH=/raw/Dataset.csv
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AQI_CSV_PATH=/mnt/f/HK1_Nam04/BigData/Data/hcmc_aqi_dataset_after_preprocess_final.csv
# live = chỉ phát cái thật; replay = phát lại mock (GIẢ LẬP, để dev giao diện)
STREAM_MODE=live
# Nguồn của luồng reading và /api/aqi/latest: hdfs (file JSON trong /stream_input, mặc định) | kafka (topic KAFKA_TOPIC, dữ liệu sống) | both
STREAM_SOURCE=hdfs
# Bật ghi lên HDFS/Kafka/Spark (mặc định tắt, backend chỉ đọc)
BACKEND_ALLOW_WRITES=
# /api/sql đọc bộ dữ liệu từ HDFS
SQL_DATASET_URI=hdfs://localhost:9000/raw/Dataset.csv
SQL_TIMEOUT_SECONDS=60
TERMINAL_IDLE_SECONDS=1800
HADOOP_LOG_DIR=/home/trong/hadoop/logs
