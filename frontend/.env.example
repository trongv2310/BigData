# Cấu hình API và Stream
# Dùng mock server: http://localhost:8010
# Dùng backend thật: http://localhost:8000
VITE_API_BASE=http://localhost:8010

# Phương thức stream: 'replay' (đọc từ mock file stream-events.ndjson) hoặc 'ws' (WebSocket thật)
VITE_STREAM=replay

# URL WebSocket khi dùng VITE_STREAM=ws
VITE_WS_URL=ws://localhost:8000/ws/stream
